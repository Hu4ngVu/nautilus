# Copy to .env next to compose.yaml and fill in
APP_DOMAIN=example.com
# Optional: where Google login lands (default https://$APP_DOMAIN/auth/callback);
# for a local stack use http://localhost:8082/auth/callback
# CLIENT_OAUTH_REDIRECT_URL=
# Optional: address the API port binds to (default 127.0.0.1)
# NAUTILUS_BIND=10.0.0.5

MYSQL_PASSWORD=
JWT_SECRET=
WEBHOOK_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=

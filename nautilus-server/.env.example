# Copy to .env next to compose.yaml and fill in
APP_DOMAIN=example.com
# Optional: address the API port binds to (default 127.0.0.1)
# NAUTILUS_BIND=10.0.0.5

MYSQL_PASSWORD=
JWT_SECRET=
WEBHOOK_SECRET_KEY=

AWS_S3_BUCKET_NAME=
# Account endpoint without the bucket: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT=
# Public base URL of the bucket (R2 custom domain), e.g. https://cdn.example.com
AWS_S3_PUBLIC_URL=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=

# Serves the static SPA and proxies the backend on the same origin,
# so the HttpOnly refresh cookie works without CORS.
:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy nautilus:3279
	}

	# Spring Security OAuth2 login endpoints
	@oauth path /oauth2/* /login/oauth2/*
	handle @oauth {
		reverse_proxy nautilus:3279
	}

	handle {
		root * /srv
		header /_nuxt/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /200.html
		file_server
	}
}
